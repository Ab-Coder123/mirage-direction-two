# ==============================================================================
# Mirage Direction Two — Monorepo Environment Variables Template
# Copy this file to .env.local in each app or root as needed.
# NEVER commit real passwords, API keys, or connection strings to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Configuration (Primary Application Database - Server Only)
# ------------------------------------------------------------------------------
# Connection URI for your MongoDB cluster (standalone, replica set, or MongoDB Atlas)
# Example Local:  mongodb://127.0.0.1:27017
# Example Atlas:  mongodb+srv://<db_user>:<db_password>@<cluster_name>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017"

# Primary database name
MONGODB_DB_NAME="mirage_pharma"

# Connection pool sizing and timeouts
MONGODB_MAX_POOL_SIZE="10"
MONGODB_MIN_POOL_SIZE="1"
MONGODB_CONNECT_TIMEOUT_MS="5000"
MONGODB_SERVER_SELECTION_TIMEOUT_MS="5000"

# ------------------------------------------------------------------------------
# Multi-App Synchronization & Revalidation
# ------------------------------------------------------------------------------
# Secret shared between apps/admin and apps/web for on-demand ISR revalidation
REVALIDATION_SECRET="mirage_revalidation_secret_placeholder"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# Admin Authentication & Authorization (Server Only - Fail Closed)
# ------------------------------------------------------------------------------
# IMPORTANT: Admin login will NOT work until real values are configured in your local
# .env.local file or production deployment environment. Do NOT commit real secrets here.
# If these variables are missing or use default placeholders, the server fails closed
# with code 'AUTH_NOT_CONFIGURED'.
#
# Generate a random 32+ character key, e.g. via terminal: openssl rand -hex 32
MIRAGE_SESSION_SECRET="replace_with_at_least_32_characters_random_hmac_secret_key"

# Primary Admin operator credentials (Server Only - never expose via NEXT_PUBLIC_*)
# Set your operator email and password in .env.local:
MIRAGE_ADMIN_EMAIL="operator@example.com"
# To generate a production scrypt hash, use hashAdminPasswordScrypt(passphrase) or:
MIRAGE_ADMIN_PASSWORD_HASH="scrypt:00000000000000000000000000000000:replace_with_scrypt_derived_key_hex"
# Optional plaintext fallback for local development only (do NOT use in production):
# MIRAGE_ADMIN_PASSWORD="replace_with_local_dev_passphrase"
MIRAGE_ADMIN_ROLE="super_admin"
MIRAGE_ADMIN_NAME="Mirage Admin Operator"

# Optional JSON array of multiple role-scoped operators:
# MIRAGE_ADMIN_USERS_JSON='[{"id":"USR-01","email":"qa@example.com","role":"qa_officer","passwordHash":"scrypt:..."}]'

# ------------------------------------------------------------------------------
# Historical / Fallback Storage Configuration
# ------------------------------------------------------------------------------
# Active primary backend is MongoDB (offline/disconnected environments fall back to static/file).
# Note: Supabase has been excised from active runtime storage; historical migrations remain in supabase/migrations/ for reference.
# MIRAGE_CONTENT_BACKEND="mongodb" # options: "mongodb" | "file"
